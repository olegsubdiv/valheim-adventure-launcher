<Window x:Class="AdventureLauncher.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Valheim Adventure RPG" Width="980" Height="940" MinWidth="820" MinHeight="780" WindowStartupLocation="CenterScreen">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="VALHEIM · ADVENTURE RPG" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
        <TextBlock Text="Your next expedition starts here." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,7"/>
        <TextBlock Text="Install once. Keep the whole collection in sync." Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Width="230" Margin="16,0,0,0">
        <TextBlock x:Name="AppVersionText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        <Button x:Name="LauncherUpdateButton" Content="Update launcher" Click="LauncherUpdate_Click" Margin="0,10,0,0"/>
        <TextBlock x:Name="LauncherUpdateStatus" Text="Checks automatically when opened" FontSize="11" Foreground="{StaticResource MutedBrush}" TextAlignment="Right" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="20" Margin="0,23,0,18">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="SettingsPanel">
        <TextBlock Text="Your installation" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15"/>
        <TextBlock Text="Valheim game folder" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="GamePathBox" IsEditable="True" ToolTip="The Steam folder containing valheim.exe"/>
          <Button Grid.Column="1" Content="Browse…" Click="BrowseGame_Click" Margin="9,0,0,0"/>
        </Grid>
        <TextBlock Text="Modpack storage folder" Foreground="{StaticResource MutedBrush}" Margin="0,13,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="ProfilePathBox" IsEditable="True" ToolTip="Select an existing profile to reuse its files, or choose a new folder on any drive."/>
          <Button Grid.Column="1" Content="Choose drive / folder…" Click="BrowseProfile_Click" Margin="9,0,0,0"/>
        </Grid>
        <TextBlock Text="An existing profile is reused, including its HD textures. For a new installation, choose an empty folder on the drive you want." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        <Grid Margin="0,13,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Texture quality" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="TextureQualityBox" ToolTip="Apply your texture choice with Install / update or Update and play while Valheim is closed. Play keeps the current files.">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#15202C"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Game language" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="GameLanguageBox" ToolTip="Applies when you launch Valheim. Also sets the language for normal Valheim starts on this Windows account.">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#15202C"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="16,0,0,0">
            <TextBlock Text="Company access code" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="CompanyCodeBox" MaxLength="64" Background="#101B27" Foreground="{StaticResource TextBrush}" BorderBrush="#405265" Padding="10,8" ToolTip="Paste the secret code from the maintainer to enable automatic HD and shader downloads. It is saved on this PC."/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Original: no HD textures, lighter memory use. Medium / Higher: HD textures." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
        <TextBlock Text="Apply with Install / update while Valheim is closed. Play keeps the current files." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="Game language applies at launch. Mods use their available translations; some text may remain English." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        <TextBlock Text="The code unlocks automatic HD and shader downloads. Without it, you can import original archives manually." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        <Expander Header="Download storage" Margin="0,13,0,0">
          <StackPanel Margin="0,9,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="CachePathBox" ToolTip="Verified downloaded archives are reused on updates."/>
              <Button Grid.Column="1" Content="Browse…" Click="BrowseCache_Click" Margin="9,0,0,0"/>
            </Grid>
            <TextBlock Text="Keep downloads on a drive with enough free space. Original archives can also be imported when requested." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
          </StackPanel>
        </Expander>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="9" Padding="20" Height="180">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusTitle" Text="Ready when you are" FontSize="17" FontWeight="SemiBold"/>
          <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Padding="12,5"/>
        </Grid>
        <TextBlock x:Name="StatusDetail" Grid.Row="1" Text="Choose your folders, then install or update the collection." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,13"/>
        <ProgressBar x:Name="OperationProgress" Grid.Row="2" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        <TextBox x:Name="ActivityLog" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" MaxHeight="160"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="3" Margin="0,18,0,0">
      <Grid x:Name="ActionPanel">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button Grid.Column="1" Content="Install / update" Click="Update_Click"/>
        <Button Grid.Column="2" Content="Update and play" Click="UpdatePlay_Click" Margin="8,0,0,0"/>
        <Button x:Name="PlayInstalledButton" Grid.Column="3" Content="Play" Click="Play_Click" Style="{StaticResource PrimaryButton}" MinWidth="130" Margin="8,0,0,0" ToolTip="Start the installed modpack through Steam without downloading updates."/>
      </Grid>
      <WrapPanel x:Name="MaintenancePanel" Margin="0,12,0,0">
        <Button x:Name="VerifyButton" Content="Verify / repair" Click="Verify_Click" Padding="0,4" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
        <Button Content="Restore previous version" Click="Rollback_Click" Margin="16,0,0,0" Padding="0,4" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
        <Button x:Name="DiagnosticsButton" Content="Collect diagnostics" Click="Diagnostics_Click" Margin="16,0,0,0" Padding="0,4" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
        <Button Content="Open modpack folder" Click="OpenProfile_Click" Margin="16,0,0,0" Padding="0,4" Background="Transparent" Foreground="{StaticResource MutedBrush}"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
